# ─── Simulator ───
SIMULATOR_URL=http://simulator-api:8000
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# ─── Backend ───
BACKEND_PORT=8080
DATABASE_PATH=./data/jalani.db
INTELLIGENCE_URL=http://intelligence-service:8081
LOG_LEVEL=INFO

# ─── Intelligence ───
INTELLIGENCE_PORT=8081
LP_SOLVER=highs
FORECAST_HORIZON_TICKS=24
